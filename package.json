{
  "name": "mandaumpix.app",
  "version": "1.0.0",
  "description": "Aplicativo web progressivo (PWA) gratuito que facilita a geração de cobranças via PIX.",
  "homepage": "https://github.com/luizcanet/mandaumpix.app#readme",
  "bugs": {
    "url": "https://github.com/luizcanet/mandaumpix.app/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luizcanet/mandaumpix.app.git"
  },
  "license": "AGPL-3.0-only",
  "author": "Luiz Henrique Canet Filho <me@luizca.net>",
  "type": "module",
  "main": "src/main.js",
  "exports": {
    ".": "./src/main.js"
  },
  "scripts": {
    "start": "jspm serve",
    "serve": "jspm serve --watch",
    "importmap": "jspm install && jspm install -o index.html --preload --integrity",
    "build": "jspm build -o dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@jspm/generator": "^2.18.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/html-vite": "^10.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^31.0.0",
    "jspm": "^4.7.0",
    "prettier": "3.9.10",
    "storybook": "^10.6.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modnes/access-controller": "^1.0.0",
    "@modnes/custom-element": "^1.1.0",
    "@modnes/data-controller": "^1.1.3",
    "@modnes/router": "^1.1.1",
    "pix-utils": "^2.8.2",
    "qr": "^0.7.2"
  }
}
