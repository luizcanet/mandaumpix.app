{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "docs/**",
      "src/**/*.test.js",
      "src/**/*.stories.js",
      "eslint.config.js",
      "vitest.config.js",
      "package.json",
      "README.md"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "!/storybook/**",
        "destination": "/index.html"
      }
    ]
  }
}
