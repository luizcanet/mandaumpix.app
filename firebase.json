{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "docs/**",
      "src/**/*.test.js",
      "src/**/*.stories.js",
      "eslint.config.js",
      "vitest.config.js",
      "package.json",
      "README.md"
    ],
    "rewrites": [
      {
        "source": "!/storybook/**",
        "destination": "/index.html"
      }
    ]
  }
}
